{
  "manifestVersion": 2,
  "id": "ask-choice",
  "name": "答案选择",
  "version": "1.0.0",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "description": "需要你拿主意时，把选项挂到输入框上方：点一下，答案就回到对话里。",
  "minAppVersion": "0.1013.0",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/input.panels",
    "app/session.start-turn",
    "app/sessions.read",
    "app/sessions.manage",
    "app/hooks.session-input"
  ],
  "contributes": {
    "settings": {
      "title": "答案选择",
      "ui": {
        "route": "/settings.html"
      }
    }
  }
}
