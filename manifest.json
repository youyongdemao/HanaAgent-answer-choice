{
  "manifestVersion": 2,
  "id": "answer-choice",
  "name": "快捷回复",
  "version": "0.2.0",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "description": "需要你拿主意时，把选项挂到输入框上方：点一下，答案就回到对话里。",
  "minAppVersion": "0.1013.0",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/input.panels",
    "app/session.start-turn",
    "app/sessions.read",
    "app/sessions.manage",
    "app/hooks.session-input",
    "app/hooks.agent-before-start",
    "app/ui.open-external"
  ],
  "network": {
    "allowedHosts": [
      "api.github.com"
    ],
    "methods": [
      "GET"
    ],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 4194304
  },
  "contributes": {
    "settings": {
      "title": "快捷回复",
      "schema": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string",
            "title": "提问形态",
            "description": "需要你拿主意时，用哪一种界面来问",
            "enum": ["panel", "card"],
            "enumNames": ["弹窗（输入框上方）", "卡片（对话里）"],
            "default": "panel"
          }
        }
      },
      "ui": {
        "route": "/settings.html"
      }
    }
  }
}
